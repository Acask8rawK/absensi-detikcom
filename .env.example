# Salin file ini menjadi .env, lalu isi nilainya.

# Supabase → Connect → ORMs → Prisma.
# DATABASE_URL: lewat pooler, port 6543 (dipakai aplikasi saat berjalan, termasuk di Vercel).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: koneksi session, port 5432 (dipakai untuk migrasi dan seed).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Kunci acak minimal 32 karakter untuk menandatangani token sesi.
# Contoh membuatnya: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Hanya untuk deploy di Vercel: kunci untuk cron harian yang menyegarkan data demo.
# Boleh dikosongkan saat menjalankan di komputer sendiri.
CRON_SECRET=""
